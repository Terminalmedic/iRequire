<?xml version="1.0" encoding="utf-8"?>
<!--
  iRequire: vastaustiedoston pohja. WinPE-vaihe tayttaa aaltosulkeissa olevat kentat
  Config\iRequire.json -tiedostosta ja kirjoittaa tuloksen polkuun
  Windows\Panther\unattend.xml. windowsPE-vaihetta ei ole, koska kuva
  puretaan DISMilla eika setup.exe:lla.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>{{KONENIMI}}</ComputerName>
      <TimeZone>{{AIKAVYOHYKE}}</TimeZone>
      <ProductKey>{{TUOTEAVAIN}}</ProductKey>
    </component>
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <!-- Ei vaadita verkkoa eika Microsoft-tilia OOBE:ssa. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg.exe add HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE /v BypassNRO /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <!-- Automaattinen laitesalaus estetaan: paikallisella tililla sen
             palautusavainta ei tallenneta minnekaan, ja BIOS-paivitys voisi
             lukita koneen. BitLocker on valinnainen (avain tikulle). -->
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg.exe add HKLM\SYSTEM\CurrentControlSet\Control\BitLocker /v PreventDeviceEncryption /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>{{NAPPAIMISTO}}</InputLocale>
      <SystemLocale>{{ALUE}}</SystemLocale>
      <UILanguage>{{KAYTTOLIITTYMA}}</UILanguage>
      <UserLocale>{{ALUE}}</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>{{KAYTTAJA}}</Name>
            <Group>Administrators</Group>
            <Password>
              <Value>{{SALASANA}}</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>{{KAYTTAJA}}</Username>
        <Password>
          <Value>{{SALASANA}}</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>{{KIRJAUTUMISIA}}</LogonCount>
      </AutoLogon>
    </component>
  </settings>
</unattend>
